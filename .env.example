# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Opcional — primeira tentativa (mais barata/rápida) na
# classificação do router (classifyAgent em server/services/autoReply.ts),
# com fallback automático pro Gemini em qualquer falha. Sem ela, o router
# usa só o Gemini como sempre (comportamento anterior, sem mudança).
# GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Backend (server.ts) ---

# SUPABASE_URL / SUPABASE_KEY: obrigatórias para as rotas de auth/banco funcionarem.
# Pegue em Supabase > Project Settings > API (o nome do secret no painel do AI Studio
# é "SUPABASE_KEY" — mantenha o mesmo nome aqui para bater com os dois ambientes).
# Use a chave no formato novo "sb_secret_..." (equivalente ao service_role, acesso
# total ao banco, ignora RLS), não o JWT legado — as chaves legadas deste projeto já
# foram desativadas (ver docs/REVISAO_E_REESTRUTURACAO.md). NUNCA exponha essa chave
# no frontend, e desative/gere outra se vazar (Project Settings > API Keys). Sem essas
# duas, o servidor sobe mesmo assim fora de produção, só com as rotas de banco
# desativadas (modo demo).
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_KEY="sb_secret_SUA_CHAVE_AQUI"

# Runtime com RLS efetivo: use a chave publicável do projeto (NÃO a sb_secret)
# para o cliente de dados tenant-scoped. Ela é combinada no backend com um JWT
# curto que leva apenas o tenant já validado; nunca exponha SUPABASE_JWT_SECRET.
# Em produção, o servidor recusa iniciar sem essas duas variáveis quando o banco
# está configurado, evitando regressão silenciosa para acesso com BYPASSRLS.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_SUA_CHAVE_AQUI"
SUPABASE_JWT_SECRET="SEGREDO_DE_ASSINATURA_JWT_DO_PROJETO_SUPABASE"

# JWT_SECRET: obrigatória em produção para assinar/validar os tokens de sessão dos
# operadores. Gere um valor aleatório forte (ex: openssl rand -base64 48) e não
# reutilize entre ambientes. Fora de produção, se ausente, o servidor gera uma
# temporária só para aquela execução (com aviso no console).
JWT_SECRET="GERE_UM_SEGREDO_FORTE_AQUI"

# PORT: porta do servidor Express (padrão 3000).
PORT="3000"

# NODE_ENV: defina como "production" ao rodar `npm start` (build já compilado),
# caso contrário o servidor tenta subir o middleware de dev do Vite.
NODE_ENV="development"

# META_WEBHOOK_VERIFY_TOKEN: token usado para validar o webhook do WhatsApp Cloud API (Meta).
# Obrigatório em produção; fora dela, gerado temporariamente se ausente.
META_WEBHOOK_VERIFY_TOKEN="defina_um_token_de_verificacao"

# META_APP_SECRET: App Secret do aplicativo Meta, usado exclusivamente para
# validar a assinatura HMAC-SHA256 dos POSTs de webhook. É obrigatório em
# produção; obtenha-o em Meta for Developers > App Settings > Basic. Nunca
# use o access token neste campo e nunca exponha este valor no frontend.
META_APP_SECRET="defina_o_app_secret_da_meta"

# GEMINI_API_KEY já declarada acima — usada pelo backend em /api/transcribe,
# /api/analyze-conversation e /api/analytics/ai-report (nunca exposta ao frontend).

# --- Pipeline de WhatsApp real (Fase 1 — opcionais até conectar um número de verdade) ---

# META_ACCESS_TOKEN: token de acesso à Graph API (diferente do META_APP_SECRET,
# que só assina o HMAC do webhook). Necessário pra baixar os áudios recebidos
# via Meta Cloud API. Sem ele, mensagens de áudio chegam mas falham ao baixar
# a mídia (erro fica registrado em /api/queue/status).
META_ACCESS_TOKEN=""

# EVOLUTION_API_URL / EVOLUTION_API_KEY / EVOLUTION_INSTANCE_NAME: endpoint e
# credenciais da sua instância Evolution API, usados pra pedir de volta o
# base64 do áudio recebido (o WhatsApp criptografa ponta-a-ponta, então a
# própria instância precisa descriptografar). Sem eles, o mesmo tipo de falha
# registrada acontece pro caminho Evolution.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME=""

# --- Push notification do PWA do atendente (issue #159) ---
# Gere o par com: npx web-push generate-vapid-keys
# Sem as duas configuradas, o servidor sobe normalmente mas o botão "Ativar
# notificações" no painel fica sem efeito (aviso no console, dev only).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto: exigido pelo protocolo Web Push — identifica o remetente pro
# serviço de push do navegador/OS. Não precisa ser uma caixa monitorada.
VAPID_SUBJECT="mailto:suporte@universo.ai"

# --- Frontend (Firebase) ---
# TASK-0191: a configuração do Firebase (usada por src/lib/firebase.ts pro
# login com Google/e-mail) vinha do arquivo firebase-applet-config.json
# committado em texto puro — GitHub Secret Scanning sinalizou a apiKey como
# vazamento público. Movida pra estas variáveis VITE_* (prefixo obrigatório
# do Vite pra expor no bundle do cliente). A apiKey do Firebase Web é pública
# por design (a segurança real vem das Firestore Rules em firestore.rules,
# não do sigilo desta chave) — a migração é só pra não comitar em texto puro
# no git, não porque o valor precise ser mantido em segredo de verdade.
# Pegue os valores em Firebase Console > Project Settings > General > Seus apps.
VITE_FIREBASE_PROJECT_ID="gen-lang-client-XXXXXXXXXX"
VITE_FIREBASE_APP_ID="1:XXXXXXXXXX:web:XXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-XXXXXXXXXX.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-XXXXXXXXXX.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="XXXXXXXXXX"
# ID do banco Firestore, se não for o "(default)" — deixe vazio se for.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
