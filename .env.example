# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Backend (server.ts) ---

# SUPABASE_URL / SUPABASE_KEY: obrigatórias para as rotas de auth/banco funcionarem.
# Pegue em Supabase > Project Settings > API (o nome do secret no painel do AI Studio
# é "SUPABASE_KEY" — mantenha o mesmo nome aqui para bater com os dois ambientes).
# Use a chave no formato novo "sb_secret_..." (equivalente ao service_role, acesso
# total ao banco, ignora RLS), não o JWT legado — as chaves legadas deste projeto já
# foram desativadas (ver docs/REVISAO_E_REESTRUTURACAO.md). NUNCA exponha essa chave
# no frontend, e desative/gere outra se vazar (Project Settings > API Keys). Sem essas
# duas, o servidor sobe mesmo assim fora de produção, só com as rotas de banco
# desativadas (modo demo).
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_KEY="sb_secret_SUA_CHAVE_AQUI"

# JWT_SECRET: obrigatória em produção para assinar/validar os tokens de sessão dos
# operadores. Gere um valor aleatório forte (ex: openssl rand -base64 48) e não
# reutilize entre ambientes. Fora de produção, se ausente, o servidor gera uma
# temporária só para aquela execução (com aviso no console).
JWT_SECRET="GERE_UM_SEGREDO_FORTE_AQUI"

# EVOHUB_API_KEY: protege as rotas /api/v1/* (facade próprio do Evo Hub, não chama
# a api.evohub.ai real ainda). Sem ela, fora de produção, as rotas ficam abertas
# (aviso no console); em produção, exigida.
EVOHUB_API_KEY="GERE_UMA_CHAVE_INTERNA_FORTE_AQUI"

# PORT: porta do servidor Express (padrão 3000).
PORT="3000"

# NODE_ENV: defina como "production" ao rodar `npm start` (build já compilado),
# caso contrário o servidor tenta subir o middleware de dev do Vite.
NODE_ENV="development"

# DEMO_MODE: controla o login com senhas fixas (LoginModal) e o endpoint
# /api/auth/demo-token. Fora de produção, ligado por padrão se ausente. Em
# produção, desligado por padrão — defina "true" explicitamente só enquanto
# não houver operadores reais cadastrados no Supabase.
DEMO_MODE="true"

# META_WEBHOOK_VERIFY_TOKEN: token usado para validar o webhook do WhatsApp Cloud API (Meta).
# Obrigatório em produção; fora dela, gerado temporariamente se ausente.
META_WEBHOOK_VERIFY_TOKEN="defina_um_token_de_verificacao"

# GEMINI_API_KEY já declarada acima — usada pelo backend em /api/transcribe,
# /api/analyze-conversation e /api/analytics/ai-report (nunca exposta ao frontend).

# --- Pipeline de WhatsApp real (Fase 1 — opcionais até conectar um número de verdade) ---

# META_ACCESS_TOKEN: token de acesso à Graph API (diferente do META_APP_SECRET,
# que só assina o HMAC do webhook). Necessário pra baixar os áudios recebidos
# via Meta Cloud API. Sem ele, mensagens de áudio chegam mas falham ao baixar
# a mídia (erro fica registrado em /api/queue/status).
META_ACCESS_TOKEN=""

# EVOLUTION_API_URL / EVOLUTION_API_KEY / EVOLUTION_INSTANCE_NAME: endpoint e
# credenciais da sua instância Evolution API, usados pra pedir de volta o
# base64 do áudio recebido (o WhatsApp criptografa ponta-a-ponta, então a
# própria instância precisa descriptografar). Sem eles, o mesmo tipo de falha
# registrada acontece pro caminho Evolution.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME=""

# --- Frontend (Firebase) ---
# A configuração do Firebase (usada por src/lib/firebase.ts e src/lib/googleAuth.ts
# para login com Google/e-mail e Google Calendar) vem do arquivo committado
# firebase-applet-config.json, não de variáveis de ambiente. A apiKey do Firebase
# Web é pública por design (a segurança real vem das Firestore Rules em
# firestore.rules) — não precisa de segredo aqui.
